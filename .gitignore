dist/
build/
*.egg-info/
__pycache__/
*.pyc
.claude/

# Local data export archives (claude.ai / chatgpt.com etc.). Can be hundreds
# of MB and contain private chat history — never commit them. Import via
# the appropriate --import flag instead.
*.zip
conversations.json

# tokstat snapshots (--dump) and exports. These contain full conversation
# transcripts and can include secrets (API tokens, keys) from past sessions —
# never commit them.
*.dump
tokstat-dump.json
